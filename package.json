{
  "name": "my-afk-client",
  "version": "1.1.0",
  "description": "Skyblocker AFK Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "mineflayer": "^4.23.0",
    "prismarine-auth": "^2.4.0",
    "socks": "^2.8.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.skyblocker.afkclient",
    "productName": "Skyblocker AFK Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "logo.png",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Skyblocker-AFK-Client-Setup.exe"
    },
    "portable": {
      "artifactName": "Skyblocker-AFK-Client-Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cronk3d",
        "repo": "AFK-Client-App",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cronk3d/AFK-Client-App.git"
  }
}
